# Backend API Base URL
# Local development default: http://localhost:5000/api
# Production deployment: https://<DEPLOYED-BACKEND-URL>/api
VITE_API_URL=http://localhost:5000/api

# Enable developer test credential shortcuts on login page (true/false)
VITE_ENABLE_DEV_AUTH=false

# Supabase Client Configuration (Optional for frontend direct integration)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

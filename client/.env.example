# ==============================================================
# RICOZANALYTICS CLIENT — ENVIRONMENT CONFIGURATION
# ==============================================================

# Backend API Base URL
# Local development: http://localhost:5000/api
# Production deployment: https://api.ricozanalytics.com/api (or /api if served on same domain)
VITE_API_URL=https://api.ricozanalytics.com/api

# Enable developer test credential shortcuts on login page (MUST be false in production)
VITE_ENABLE_DEV_AUTH=false

# Supabase Client Configuration (Optional frontend direct integration)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Maximum file upload size in MB (CSV / JSON data sources)
VITE_MAX_UPLOAD_SIZE_MB=250


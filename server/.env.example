# ==============================================================
# RICOZANALYTICS ENTERPRISE PLATFORM — PRODUCTION CONFIGURATION
# ==============================================================

# ==============================================================
# 1. REQUIRED PRODUCTION SECRETS (Keep secret, never commit)
# ==============================================================

# Production PostgreSQL Database URL (Supabase Pooler with SSL)
# Format: postgresql://postgres.[REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Cryptographic JSON Web Token Secret (Min 64 random characters)
JWT_SECRET=your-secure-random-64-character-production-jwt-secret-key-here

# Stripe Live Production API Keys
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_stripe_webhook_signing_secret

# Zoho Mail Enterprise SMTP App Password (16-character generated app password)
SMTP_PASSWORD=your_zoho_16_character_app_password

# Supabase Service Role Secret Key (Server-side administrative access only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================
# 2. REQUIRED PUBLIC CONFIGURATION
# ==============================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000
MAX_UPLOAD_SIZE_MB=250
QUALITY_BATCH_SIZE=25000
QUALITY_MAX_CONCURRENT_JOBS=2
QUALITY_SAMPLE_SIZE=10000
QUALITY_JOB_TIMEOUT_MS=600000

# Production Domains & CORS Whitelist (Do NOT use wildcard * in production)
CLIENT_URL=https://app.ricozanalytics.com
CORS_ORIGIN=https://app.ricozanalytics.com

# Zoho Mail Enterprise SMTP Gateway Configuration
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=care@ricoz.in
SMTP_FROM=care@ricoz.in
DEMO_REQUEST_EMAIL=care@ricoz.in

# Supabase Public Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=datasets

# ==============================================================
# 3. OPTIONAL AI & MICROSERVICE INTEGRATIONS
# ==============================================================

# Google Gemini API (For advanced natural language dashboard explanations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Python Machine Learning Microservice URL (Optional, fallback statistical models active)
ML_SERVICE_URL=http://127.0.0.1:8000

# Stripe Client Publishable Key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Database Connection Pool Tuning
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
JWT_EXPIRATION=7d

# ==============================================================
# 4. DEVELOPMENT & TEST-ONLY VARIABLES (Leave blank in production)
# ==============================================================
# TEST_PORT=5098
# TEST_API_URL=http://localhost:5000/api

# ==============================================================
# RICOZANALYTICS ENTERPRISE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================

# Core Application Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Primary Database Connection
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/ricoz_analytics?sslmode=require
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000

# Authentication & Security
JWT_SECRET=your-secure-random-64-char-jwt-secret-key-do-not-share
JWT_EXPIRATION=7d

# Supabase Auth & Storage Integration
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI & Machine Learning Integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ML_SERVICE_URL=http://127.0.0.1:8000

# Zoho Mail Enterprise SMTP Notification Gateway
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=care@ricoz.in
SMTP_PASSWORD=your_zoho_app_password_here
SMTP_FROM=care@ricoz.in
DEMO_REQUEST_EMAIL=care@ricoz.in

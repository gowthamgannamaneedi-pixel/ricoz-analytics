# RicozAnalytics AI Agentic RAG Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Database Configuration (matches Node.js Express backend DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ricoz_analytics
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/ricoz_analytics

# Internal Service-to-Service Authentication
AI_SERVICE_SECRET=ricoz_ai_service_secure_key_production_2026

# Execution Limits
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=1000
MAX_TOOL_CALLS_PER_QUERY=5

# LLM Configuration (Optional hosted model API key)
GEMINI_API_KEY=
OPENAI_API_KEY=

